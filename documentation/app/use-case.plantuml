@startuml FZ22_UseCases
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam actorStyle awesome

skinparam usecase {
    BorderColor #4A90D9
    ArrowColor #4A90D9
}

skinparam actor {
    BackgroundColor #FAFAFA
    BorderColor #555
}

left to right direction

' ── Akteure ──────────────────────────────────────────────
actor "Forscher:in" as USER #LightSalmon

' ── Use Cases ─────────────────────────────────────────────
rectangle "Test- und Evaluierungsumgebung" {

    usecase "Oral History Interviews laden" as UC1
    usecase "Pfadangabe für Dateien machen" as UC1_1
    usecase "Ordnerauswahl mit Anzeige\nenthaltener Textdateien" as UC1_1_1

    usecase "TAP-Elemente in OHI-Texten\nklassifizieren" as UC2
    usecase "Modellinferenz starten" as UC2_1
    usecase "AM-Modell laden" as UC2_1_1

    usecase "Klasifizierung durch das Modell\nbewerten" as UC3
    usecase "grafische Anzeige erkannter\nSpans mit Label" as UC3_1
    usecase "Manuell neue Spans hinzufügen" as UC3_2
    usecase "Erkannte Spans bearbeiten/\nlöschen" as UC3_3
    usecase "Bewertung abspeichern/\nexportieren" as UC3_4
}

' ── Beziehungen Forscher:in ────────────────────────────────
USER --> UC1
USER --> UC2
USER --> UC3

' ── Include / Extend ──────────────────────────────────────
UC1         .right.>    UC1_1  : <<include>>
UC1_1_1     .up.>       UC1_1 : <<extend>>
UC2         .right.>    UC1  : <<include>>
UC2         .down.>     UC2_1  : <<include>>
UC2_1       .right.>    UC2_1_1 : <<include>>
UC3         .right.>    UC2 : <<include>>
UC3         .left.>     UC3_1 : <<include>>
UC3         .down.>     UC3_3 : <<include>>
UC3_2       .up.>       UC3 : <<extend>>
UC3         .down.>     UC3_4 : <<include>>

@enduml
