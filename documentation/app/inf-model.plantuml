@startuml Information Model: App
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #F0FAF4
    BorderColor #27AE60
    ArrowColor #333
    HeaderBackgroundColor #27AE60
    HeaderFontColor white
}

skinparam file {
    BackgroundColor #LightYellow
}

skinparam folder {
    BackgroundColor #LightYellow
}

class FileScanner {
    + directory : Path
    ---
    + scan(Path) : List[Path]
    + load_file(Path) : str
}

folder model_best {

}

file ohi_text {
}

file export_json {

}

class Span {
    + start : int
    + end : int
    + label : str
    + text : str
}

class SessionState {
    + spans : List[Span]
    + text : str
    + file : Path
}

class AMModelAdapter {
    + model_path : Path
    ---
    + load() : AMModelAdapter
    + predict(str) : List[Span]
}

class SpanEditor {
    ---
    + edit(Span) : Span
    + create(int, int, str) : Span
}

' ── Beziehungen ────────────────────────────────────────────────────────────────

FileScanner   "1"    -->  "0..*" ohi_text       : findet & lädt
AMModelAdapter "1" --> "1" ohi_text             : Inferenz
Span         "0..*"  --o  "1"   SessionState    : hält aktuell
Span         "0..*"  -->  "1"   export_json     : exportiert als
AMModelAdapter "1"   -->  "0..*" Span           : erzeugt
AMModelAdapter "1" --> "1" model_best           : lädt
SpanEditor "1" --> "1" SessionState       : greift auf Spans zu

@enduml
