@startuml FZ22_Informationsmodell
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #F0FAF4
    BorderColor #27AE60
    ArrowColor #333
    HeaderBackgroundColor #27AE60
    HeaderFontColor white
}

title Informationsmodell: Test- und Evaluierungsumgebung (FZ 2.2)

' ── Klassen ───────────────────────────────────────────────────────────────────

class FileScanner {
    + directory : Path
    + supported_extensions : List[str]
    + files : Dict[str, Path]
}

class TextFile {
    + filename : str
    + filepath : Path
    + content : str
    + encoding : str
    + line_count : int
    + char_count : int
}

class Span {
    + start : int
    + end : int
    + label : str
    + text : str
    + score : float
}

class Session {
    + id : int
    + filename : str
    + filepath : str
    + text : str
    + spans : List[Span]
    + status : str
    + created_at : str
    + updated_at : str
}

class SessionStore {
    + db_path : Path
    + connection : sqlite3.Connection
}

class AnnotationExport {
    + text : str
    + spans : List[Span]
    + timestamp : str
    + source : str
    + span_count : int
    + export_path : Path
}

class AppState {
    + current_text : str
    + current_file : str
    + current_spans : List[Span]
    + analyzed : bool
    + active_span_idx : int
}

class AMModelAdapter {
    + model_path : Path
    + is_loaded : bool
    + threshold : float
}

' ── Beziehungen ────────────────────────────────────────────────────────────────

FileScanner  "1" --> "0..*" TextFile       : findet
TextFile     "1" --> "0..*" Span           : erhält durch\nAnalyse
Span        "0..*" --* "1"  Session        : gespeichert in
Session      "0..*" --* "1" SessionStore   : verwaltet durch
Session      "1"   --> "1"  AnnotationExport : exportiert als
AppState     "1"   --> "0..*" Span         : hält aktuell
AppState     "1"   --> "1"  TextFile       : referenziert
AMModelAdapter "1" --> "0..*" Span         : erzeugt

note right of Session
  status ∈ {in_progress, done}
end note

note right of Span
  label ∈ {CLAIM, DATA,
  WARRANT, REBUTTAL}
end note

note bottom of SessionStore
  Persistenz via SQLite
  (progress.db)
  lokal, kein Cloud-Zugriff
end note

@enduml
