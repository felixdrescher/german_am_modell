@startuml Use-Case Modell
!theme plain

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam actorStyle awesome

skinparam usecase {
    BorderColor #4A90D9
    ArrowColor #4A90D9
}
skinparam actor {
    BackgroundColor #FAFAFA
    BorderColor #555
}

left to right direction

' ── Akteure ──────────────────────────────────────────────
actor "Entwickler" as DEV #PaleGreen

rectangle "AM-Modell Pipeline" {
    
    usecase "Modell auf TAP-Elemente\nin DARIUS trainieren" as UC1
    usecase "Modell-Konfiguration\ninitial festlegen" as UC1_1
    usecase "DARIUS-Korpus laden\nund Vorverarbeitung" as UC1_2
    usecase "Modell evaluieren" as UC1_3

    usecase "Modellkonfiguration ändern" as UC2
    
    usecase "Modell\nspeichern" as UC5
}

' Beziehungen
DEV --> UC2
DEV --> UC1

' Hierarchien: Konfiguration ist Teil des Trainings-Workflows
UC1 .down.> UC1_1 : <<include>>
UC1 .down.> UC1_2 : <<include>>
UC1 .down.> UC1_3 : <<include>>
UC2 .left.> UC1 : <<extend>>

UC5 .left.> UC1 : <<extend>>


@enduml