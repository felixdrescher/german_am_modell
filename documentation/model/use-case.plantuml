@startuml Use-Case Modell
!theme mars

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam actorStyle awesome

skinparam usecase {
    BackgroundColor #EEF4FB
    BorderColor #4A90D9
    ArrowColor #4A90D9
}
skinparam actor {
    BackgroundColor #FAFAFA
    BorderColor #555
}

left to right direction

' ── Akteure ──────────────────────────────────────────────
actor "Entwickler" as DEV #PaleGreen
actor "Forscher:in" as RES #LightSalmon

rectangle "AM-Modell Pipeline" {
    usecase "Modell auf TAP-Elemente\nin DARIUS trainieren" as UC1
    usecase "Modell-Konfiguration\nfestlegen" as UC2
    usecase "DARIUS-Korpus laden\nund Vorverarbeitung" as UC3
    usecase "Modell evaluieren" as UC4
    usecase "bestes Modell\nspeichern" as UC5
    usecase "Modell laden" as UC6
}

component "Evaluierungsumgebung" as EVAL_ENV <<system>> #LightYellow

' Beziehungen
DEV --> UC1
RES --> EVAL_ENV : <<uses>>
EVAL_ENV --> UC6

' Hierarchien: Konfiguration ist Teil des Trainings-Workflows
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC5 .right.> UC1 : <<extend>>
UC6 ..> UC5 : <<include>>


@enduml