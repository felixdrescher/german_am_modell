@startuml Use-Case Modell
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam actorStyle awesome

skinparam usecase {
    BackgroundColor #EEF4FB
    BorderColor #4A90D9
    ArrowColor #4A90D9
}
skinparam actor {
    BackgroundColor #FAFAFA
    BorderColor #555
}

left to right direction

' ── Akteure ──────────────────────────────────────────────
actor "Entwickler" as DEV #PaleGreen
actor "Forscher:in" as RES #LightSalmon

' ── Use Cases ─────────────────────────────────────────────
rectangle "AM-Modell Pipeline" {
    usecase "UC1: Modell trainieren" as UC1
    usecase "UC2: Daten vorverarbeiten" as UC2
    usecase "UC3: Modell evaluieren" as UC3
    usecase "UC4: Modell über API nutzen" as UC4
    
    ' Layout-Stabilisierung (Hidden Links)
    UC2 -[hidden]down-> UC1
    UC1 -[hidden]down-> UC3
    UC3 -[hidden]down-> UC4
}

' ── Beziehungen ───────────────────────────────────────────
' Akteure mit ihren primären Zielen
DEV --> UC1
RES --> UC4

' Fachliche Abhängigkeiten
' UC1 benötigt zwingend UC2
UC1 ..> UC2 : <<include>>

' Optionale Erweiterungen (vom erweiternden UC zum Basis-UC)
UC3 ..> UC1 : <<extend>>

@enduml