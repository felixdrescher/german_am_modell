@startuml FZ12_Architektur
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 8

skinparam package {
    BackgroundColor #EEF4FB
    BorderColor #4A90D9
    FontColor #333
    FontStyle bold
}
skinparam component {
    BackgroundColor white
    BorderColor #4A90D9
}
skinparam folder {
    BackgroundColor #LightYellow
}

skinparam file {
    BackgroundColor #LightYellow
}
skinparam cloud {
    BackgroundColor #F0FAF4
    BorderColor #27AE60
}


' ── Schicht 1: Externe Daten ─────────────────────────────────────────────────
package "Datenschicht" {
    folder "DARIUS-Korpus\n(*.tsv)" as DARIUS
    folder "train.spacy\ndev.spacy" as DOCBIN
    folder "model-best\n(trainiertes Modell)" as MODELFILES
}

' ── Schicht 2: Vorverarbeitung ───────────────────────────────────────────────
package "Vorverarbeitungsschicht" {
    component "preprocessing.py\n─────────────────\nparse_tsv()\nextract_spans()\nconvert_to_bindoc()" as PRE
}

' ── Schicht 3: Training ──────────────────────────────────────────────────────
package "Trainingsschicht" {
    component "training.py\n─────────────────\nrun_training()\nrun_evaluation()" as TRAIN

    file "model.cfg" as CFG
}

' ── Schicht 4: Modell ────────────────────────────────────────────────────────
package "Modellschicht" {
    component "model.py\n─────────────────\nload()\npredict()" as MODEL
}

' ── Externe Abhängigkeiten ───────────────────────────────────────────────────
cloud "HuggingFace Hub" as HF

cloud "Kaggle Kernels .ipynb" as GPU

' ── Abhängigkeiten ────────────────────────────────────────────────────────────
TRAIN          -up-> HF  : lädt\nSprachmodell
TRAIN         <-left- GPU  : führt aus
DARIUS      -->     PRE    : liest ein
PRE         -->     DOCBIN : erzeugt
TRAIN      -->    DOCBIN  : nutzt
CFG         -->     TRAIN  : konfiguriert
TRAIN       -->   MODELFILES : speichert
MODEL       -up-> MODELFILES : lädt


@enduml
