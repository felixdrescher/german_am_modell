@startuml Use-Case Modell
!theme plain
skinparam actorStyle awesome

skinparam usecase {
    BackgroundColor #EEF4FB
    BorderColor #4A90D9
}

left to right direction

' ── Akteure ──────────────────────────────────────────────
actor "Entwickler" as DEV #PaleGreen
actor "Forscher:in" as RESEARCHER #LightSalmon

' ── Use Cases ─────────────────────────────────────────────
rectangle "AM-Modell System" {
    usecase "UC1: Korpus vorverarbeiten" as UC1
    usecase "UC2: Modell trainieren" as UC2
    usecase "UC3: Modell-Hyperparameter anpassen" as UC3
    usecase "UC4: Modell interaktiv testen" as UC4
    usecase "UC5: Modell-Performance analysieren" as UC5
    usecase "UC6: Code versionieren" as UC6
}

' ── Beziehungen ───────────────────────────────────────────
' Entwickler fokussiert auf Setup und Code
DEV --> UC1
DEV --> UC6
DEV --> UC2

' Forscher fokussiert auf Anwendung und Analyse
RESEARCHER --> UC3
RESEARCHER --> UC4
RESEARCHER --> UC5

' Logische Abhängigkeiten
UC2 ..> UC1 : <<include>>
UC3 ..> UC2 : <<extend>>
UC5 ..> UC4 : <<extend>>

@enduml