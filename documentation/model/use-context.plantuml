@startuml Context-Diagrammkaggle kernels output felixdrescher/am-modell-1 -p /path/to/dest
left to right direction

actor "Data Scientist" as DS
actor "End User / Pipeline" as EU

rectangle "Argumentation Mining Modell" as AMM

database "TSV Dataset (Annotated Data)" as DATA
database "Configuration Files" as CFG

DS --> AMM : train / test / configure
EU --> AMM : predict (inference)

DATA --> AMM : training data input
CFG --> AMM : training configuration

AMM --> EU : annotated JSON output
AMM --> DS : evaluation results

@enduml