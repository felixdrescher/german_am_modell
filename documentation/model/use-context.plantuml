@startuml FZ12_Anwendungskontext
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam actorStyle awesome

skinparam rectangle {
    BackgroundColor #EEF4FB
    BorderColor #4A90D9
    BorderThickness 2
}
skinparam actor {
    BackgroundColor #FAFAFA
    BorderColor #555
}
skinparam folder {
    BackgroundColor #FFF8EC
    BorderColor #E67E22
}
skinparam cloud {
    BackgroundColor #F0FAF4
    BorderColor #27AE60
}

title Anwendungskontext: AM-Modell (FZ 1.2)

' ── Akteure ──────────────────────────────────────────────
actor "Entwickler" as DEV #PaleGreen
actor "Forscher:in" as RESEARCHER #LightSalmon
actor "Kaggle Kernel .ipynb" as KAGGLE #LightBlue

' ── Externes System im Fokus ─────────────────────────────
rectangle "AM-Modell\n(NLP-Pipeline)" as AM {
    folder "DARIUS-Korpus" as DARIUS
    rectangle "preprocessing.py" as PRE
    file "dev.spacy" as DTEST
    file "train.spacy" as DTRAIN
    rectangle "training.py" as TRAIN
    file "model.cfg" as CFG 
    rectangle "model.py" as INF
    folder "model-best/\n(trainiertes Modell)" as MODEL
}

' ── Externe Datenquellen ──────────────────────────────────
cloud "HuggingFace" as HF
cloud "GIT-Repository" as GIT

' ── Streamlit App (Nachbarsystem) ────────────────────────
rectangle "Schnittstelle\n(Evaluierungsumgebung)" as UI

' ── Beziehungen ───────────────────────────────────────────
' extern
RESEARCHER  -down-> UI              : nutzt
KAGGLE      -up-> GIT               : lädt Code       
DEV         -left-> KAGGLE          : startet

' extern <-> intern
UI          -left-> INF             : ruft auf
INF         -right-> UI             : Span-Liste
AM          -[dashed]up-> GIT       : wird gespeichert\lund versioniert
KAGGLE      -down-> PRE             : führt aus
KAGGLE      -down-> TRAIN           : führt aus
KAGGLE      -down-> CFG             : ändert
TRAIN       -[dashed]left-> HF      : lädt vortrainiertes Modell

' intern
DARIUS      -down-> PRE             : .tsv-Dateien
PRE         -down-> DTRAIN          : erzeugt
PRE         -down-> DTEST           : erzeugt
TRAIN       -up-> DTRAIN            : nutzt\l(Training)
TRAIN       -up-> DTEST             : nutzt\l(Evalution)
TRAIN       -right-> CFG            : liest
INF         -left-> MODEL           : ruft auf
TRAIN       -down-> MODEL           : speichert bestes\lModell

@enduml
